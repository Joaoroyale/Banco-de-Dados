CREATE DATABASE ifpe;

create table Aluno (
matricula Int primary key,
nome VARCHAR(20),
cpf CHAR (11),
sexo CHAR(1),
turma varchar(2)
);

select * from aluno;

alter table aluno
add column turma varchar(2);

drop table aluno;

